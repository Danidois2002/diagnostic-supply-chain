# Copier ce fichier en .env pour le développement local (npm run dev le lit automatiquement)

# Base PostgreSQL. Sans valeur : PGlite en mémoire (rien à installer, données perdues à l'arrêt).
# « pglite://.data » garde les données dans le dossier .data. En production : l'URL Neon.
# DATABASE_URL=postgres://utilisateur:mot-de-passe@hote/base?sslmode=require

# Port HTTP (3000 par défaut)
# PORT=3000

# Origines autorisées à appeler l'API (séparées par des virgules)
# CORS_ORIGINS=http://localhost:5173,https://danidois2002.github.io

# Durée de conservation des coordonnées, en jours (30 par défaut)
# RETENTION_DAYS=30

# Nombre de diagnostics simulés créés au premier démarrage (40 par défaut, 0 pour aucun)
# SIMULATIONS=40

# Espace admin : mot de passe du compte « admin » (sans valeur, seul le compte de démonstration existe)
# ADMIN_PASSWORD=
# ADMIN_USERNAME=admin

# Mot de passe du compte de démonstration « demo » (lecture seule, coordonnées masquées)
# DEMO_PASSWORD=diagnostic

# Clé de signature des sessions (sans valeur : clé aléatoire, sessions perdues au redémarrage)
# JWT_SECRET=
